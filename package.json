{
  "name": "flakeproof",
  "version": "0.1.0",
  "private": true,
  "description": "When CI goes red, flakeproof tells you whether it is a real bug or a fragile test, and proves a better selector instead of guessing one.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippmelikidis/flakeproof.git"
  },
  "bugs": {
    "url": "https://github.com/philippmelikidis/flakeproof/issues"
  },
  "homepage": "https://github.com/philippmelikidis/flakeproof#readme",
  "keywords": [
    "testing",
    "e2e",
    "flaky-tests",
    "playwright",
    "robot-framework",
    "ci"
  ],
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "spike": "node spikes/run-phase0.js",
    "lint": "eslint ."
  },
  "bin": { "flakeproof": "bin/flakeproof.js" },
  "exports": {
    ".": "./src/triage/engine.js",
    "./inject": "./src/inject/playwright.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "fast-xml-parser": "^5.11.0",
    "globals": "^17.11.0",
    "playwright": "^1.62.1"
  }
}
